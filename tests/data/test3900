<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
EPSV
RETR
MODE B
</keywords>
</info>

# Server-side
<reply>
<data nonewline="yes">
%hex[%00%00%06]hex%hello %hex[%00%00%06]hex%block %hex[%00%00%05]hex%mode%hex[%0a]hex%%hex[%40%00%00]hex%
</data>
<datacheck>
hello block mode
</datacheck>
<size>
17
</size>
<servercmd>
REPLY MODE 200 Mode set to B.
</servercmd>
</reply>

# Client-side
<client>
<server>
ftp
</server>
<name>
FTP RETR twice in block mode (MODE B), 226 closes the data conn
</name>
<command>
--ftp-block-mode ftp://%HOSTIP:%FTPPORT/%TESTNUMBER ftp://%HOSTIP:%FTPPORT/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
MODE B
EPSV
TYPE I
SIZE %TESTNUMBER
RETR %TESTNUMBER
EPSV
SIZE %TESTNUMBER
RETR %TESTNUMBER
QUIT
</protocol>
</verify>
</testcase>
