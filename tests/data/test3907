<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
EPSV
STOR
MODE B
</keywords>
</info>

# Server-side
<reply>
<servercmd>
REPLY MODE 200 Mode set to B.
STORBLOCK
</servercmd>
</reply>

# Client-side
<client>
<server>
ftp
</server>
<name>
FTP upload of an empty file in block mode (MODE B)
</name>
<command>
--ftp-block-mode ftp://%HOSTIP:%FTPPORT/%TESTNUMBER -T %LOGDIR/upload%TESTNUMBER
</command>
<file name="%LOGDIR/upload%TESTNUMBER">
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<upload nonewline="yes">
%hex[%40%00%00]hex%
</upload>
<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
MODE B
EPSV
TYPE I
STOR %TESTNUMBER
QUIT
</protocol>
</verify>
</testcase>
