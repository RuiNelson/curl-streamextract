<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
EPSV
RETR
MODE B
</keywords>
</info>

# Server-side
<reply>
<data>
data in stream mode
</data>
</reply>

# Client-side
<client>
<server>
ftp
</server>
<name>
FTP --ftp-block-mode with MODE B refused, stream mode
</name>
<command>
--ftp-block-mode ftp://%HOSTIP:%FTPPORT/%TESTNUMBER ftp://%HOSTIP:%FTPPORT/%TESTNUMBER
